# Export these variables in your shell; this file is not loaded automatically.
GEMINI_API_KEY=
AUTOCV_MODEL=gemini-3.5-flash-lite
AUTOCV_OUTPUT_DIR=output
# Comma-separated explicit origins. Empty disables cross-origin browser access.
AUTOCV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL URL. This default matches docker-compose.yml (local development only).
DATABASE_URL=postgresql+psycopg://autocv:autocv@127.0.0.1:55432/autocv
# Integration tests only; the database name must end in _test.
AUTOCV_TEST_DATABASE_URL=postgresql+psycopg://autocv:autocv@127.0.0.1:55432/autocv_test
